{
  "name": "nk-chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source chess education platform: course catalogue, interactive studies and drills",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify": "node scripts/verify.mjs",
    "engine:audit": "node scripts/engine-audit.mjs --depth 16 --after-depth 12",
    "engine:report": "node scripts/engine-report.mjs",
    "theory:check": "node scripts/theory-check.mjs",
    "theory:triage": "node scripts/theory-triage.mjs",
    "theory:ping": "node scripts/theory-check.mjs --ping",
    "theory:trapcheck": "node scripts/trap-check.mjs"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
